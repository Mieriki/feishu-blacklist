{
  "manifest_version": 3,
  "name": "飞书手动黑名单",
  "version": "1.0.0",
  "description": "在飞书网页版按人屏蔽消息：悬停消息即可屏蔽此人，支持完全隐藏与划线占位两种模式，随时撤销。",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "飞书手动黑名单",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.feishu.cn/*",
        "*://*.larksuite.com/*",
        "*://*.larkoffice.com/*"
      ],
      "js": ["src/content-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.feishu.cn/*",
        "*://*.larksuite.com/*",
        "*://*.larkoffice.com/*"
      ],
      "js": ["src/content-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
